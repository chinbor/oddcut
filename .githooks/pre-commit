#!/bin/sh
# Quick self check before every commit (enable once: git config core.hooksPath .githooks).
# Skip only in an emergency: git commit --no-verify
root="$(git rev-parse --show-toplevel)"
py="$root/.venv/Scripts/python.exe"
[ -x "$py" ] || py="$root/.venv/bin/python"
[ -x "$py" ] || py="python"
exec "$py" "$root/code/tools/check.py"
